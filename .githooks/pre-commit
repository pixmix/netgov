#!/usr/bin/env python3
# artefact-version: netgov-publish-gate/1.1
"""Publish gate for netgov — refuse anything that names the network it was written on.

This repository is PUBLIC. The tool is meant to be shared; the network it was developed
against is not. That split is the whole rule, and it cannot rest on someone remembering it
while pasting a fixture at 01:00.

WHY THIS IS NOT THE mgz-tools GATE, though it started as a copy of it (thanks, c-019):

  netgov is a LAN policy-routing tool. Private addresses, MACs and SSIDs are its SUBJECT
  MATTER — every doc and half the tests must contain them. A gate that refuses private
  addresses outright would refuse every honest commit, get bypassed within a day, and then
  be worse than nothing: it would look like coverage. ⇒ this gate does the inverse. It
  ALLOWS a small, explicit set of documentation values and refuses every other address,
  MAC or hostname of the shapes we care about. Adding a new example means adding it here,
  in one visible line, which is the point.

THE AXES, and the one that earned this file:

  · IPv4 — anything private-range that is not in ALLOW_V4. Our own LAN is one of those
    the fixtures now say 10.0.0.0/24.
  · IPv6 — any global-unicast address (2000::/3) outside 2001:db8::/32, and any ULA
    outside fd00:db8::/32. ⭐ THIS IS THE ONE THAT MATTERED. Until 2026-09-10 the tests
    carried a REAL, GLOBALLY ROUTABLE /64 from a residential
    ISP, with the host's actual interface identifiers, sitting in a public repo. It was
    invisible to a review that searched for private ranges, because it is not one. A
    global address is the opposite of RFC1918: it is the case where publishing the map
    also publishes the territory.
  · MAC — anything outside the RFC 7042 documentation range 00:00:5E:00:53:xx (and its
    locally-administered twin 02:00:5E:00:53:xx, which the parked-MAC examples need), plus
    a couple of visibly-fake ones. A real `ip -j addr` paste always carries a real MAC, so
    this axis catches the paste even when the addresses look innocent.
  · NAMES — our hosts, SSIDs and domains, in words rather than numbers.
  · CREDENTIAL BY CONTEXT — a value is a credential because of the NAME in front of it,
    however weak. A memorable WPA2 passphrase is low-entropy by construction; that is the
    point of it, and an entropy scan reads it as prose. (Two PSKs once sat in a private
    history for three weeks past an entropy-only guard.)

FAILS CLOSED. Any error while scanning refuses the commit. A guard that silently does not
run manufactures confidence, which is worse than no guard.

Install:  git config core.hooksPath .githooks
Bypass:   git commit --no-verify   (inherent to git; this guards against accident)
"""
import hashlib
import ipaddress
import re
import subprocess
import sys

VERSION = "netgov-publish-gate/1.1"
if "--version" in sys.argv:
    print(VERSION)
    sys.exit(0)

# ---------------------------------------------------------------- allowlists --
# Documentation values. Everything of these shapes that is NOT here is refused.
ALLOW_V4_NETS = [ipaddress.ip_network(n) for n in (
    "10.0.0.0/24",       # the generic LAN the fixtures and docs use
    "10.99.99.0/24",     # "a device that does not exist" in the claim tests
    "172.16.0.0/16", "172.18.0.0/16", "172.20.0.0/16",   # container-subnet examples
    "192.168.0.0/24",    # a generic "some other LAN" in the docs
)]
ALLOW_V6_NETS = [ipaddress.ip_network(n) for n in (
    "2001:db8::/32",     # RFC 3849 documentation prefix
    # `fd00::/16` — the conventional "example ULA" corner. Deliberately wider than a single
    # documentation prefix, because `fd00::/8` is the ULA RANGE ITSELF (RFC 4193) and a
    # comment saying so is not a leak; `fd00::1` is as generic as an address gets. Our real
    # ULA is a different fd-prefix, which stays refused. Found by the gate rejecting its own repo.
    "fd00::/16",
    # Public anycast resolvers the tool PINGS. These are global on purpose and belong in
    # the code: they are a well-known service, not a machine of ours. Caught as a false
    # positive on this gate's own first run, which is the right way to find the line.
    "2606:4700:4700::/48",   # Cloudflare DNS — the v6 reachability probe target
    "2620:fe::/48",          # Quad9, if a probe ever moves there
)]
# A designator naming a whole ADDRESS CLASS is not a machine. `fc00::/7` is "the ULA range" and
# `2000::/3` is "global unicast"; a routing tool cannot discuss its own rules without writing them.
# Enumerated by listing every parseable v6 token in the tree at once rather than discovering them
# one failed run at a time — three consecutive false positives is a signal to stop iterating and
# go and look.
ALLOW_V6_LITERAL = {"fc00::/7", "2000::/3", "::/0", "::/128"}

ALLOW_MAC = re.compile(
    r"^(?:00|02):00:5e:00:53:[0-9a-f]{2}$"   # RFC 7042 doc range + its LA twin
    r"|^02:11:22:33:44:55$|^11:22:33:44:55:66$|^aa:bb:cc:dd:ee:ff$", re.I)

# ------------------------------------------------------------------- scanners --
RX_V4 = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")
# ⚠️ NO TRAILING \b. A word boundary cannot exist between `:` and `/`, so `\b` forced
# `2a01:...:2c00::/64` to match as `2a01:...:2c00` — which does not parse, so the prefix
# form was silently skipped. Optional /len is captured and parsed as a network.
RX_V6 = re.compile(r"(?<![0-9a-fA-F:])[0-9a-f]{0,4}(?::[0-9a-f]{0,4}){2,7}(?:/\d{1,3})?", re.I)
# nmcli's terse output escapes the separator (`4A\:21\:0B\:…`), so the backslash is
# OPTIONAL, not an alternative separator. Written the other way this pattern misses every
# escaped MAC — which is exactly the form that slipped past a hand-written grep on
# 2026-09-10, twice, before a mutation test caught it here.
RX_MAC = re.compile(r"\b(?:[0-9a-f]{2}\\?[:-]){5}[0-9a-f]{2}\b", re.I)

# ⚠️ THESE ARE HASHES BECAUSE A BLOCKLIST OF NAMES IS ITSELF THE MAP.
# v1.0 listed our hostnames, SSIDs, semaphore names and domains as plain literals here, and
# exempted this file from its own scan so it could. The first push proved how bad that trade
# was: the tree went from 81 scattered occurrences to ELEVEN LINES — but those eleven lines
# were a curated, commented inventory in one place, which is strictly more useful to a
# stranger than the scatter it replaced. A guard that has to name what it guards, publishes it.
#
# So: SHAPE rules stay literal above (private ranges, non-documentation v6 and MACs are generic
# networking facts and leak nothing), and NAME rules are salted digests. Text is tokenised and
# re-joined into short n-grams, each hashed and compared.
#
# ⚠️ HONEST LIMIT: the salt is in this file, so this defeats reading, not a determined
# dictionary attack against guessable names. It is not a secret store. What it buys is that
# the repository no longer *contains* the inventory — which was the actual defect.
SALT = "netgov-publish-gate/1.1"


def _digest(t):
    return hashlib.sha256((SALT + "|" + t.lower()).encode()).hexdigest()[:16]


HASHED_NAMES = [
    # hostname or box model — a map is what a stranger lacks
    (['1489d51711b3bdb5', '3028fb7e1f4e89f7', '3ac32416d31b7d29', '3b9b7543ff513a75', '5c2288add98c8459', '68e8d00139bf5071', '71548158ed17ebc6', '7f4ec9f3448497a2', '864e78498d622b9d', '93a9a2779214bda9', 'a97c181433896ed4', 'a9aad02385240cb0', 'a9df132738515a46', 'bbb8e05fef8d5736', 'be746349fc0ca9a5', 'c0b02aad7e5c97c1', 'c2e7477f27f0de5e', 'ed8eec5bdef84d47', 'f5aae58749949c51'],
     "hostname or box model — a map is what a stranger lacks"),
    # internal semaphore name — it names a contract, a host, and that a mesh exists
    (['03c28464a4eb81af', '0a0a4c19e04510c3', '26852c10b080bbea', '2f321873e60280cf', '42edf6c23e657e13', '471bbe9ff99cd392', '47c342376af33963', '5d67a6dd2ed408d1', '6d9753dd7e73aae0', '79530a690250bab2', '9f2607ed5626baca', 'c7bbd435f13b225c'],
     "internal semaphore name — it names a contract, a host, and that a mesh exists"),
    # one of our SSIDs — it names a place as well as a network
    (['3b74ef15e5ba713d', '454f9c3bee13a496', '7c0d641aa8b85d3f', 'a7b99628785c5500', 'c83e0d4b055e4f8c', 'ea4874422d1b9a6c', 'fcb0c133643acf8d'],
     "one of our SSIDs — it names a place as well as a network"),
    # an internal, cover or personal domain of ours
    (['0fea25a06285b706', '18330361103e612a', '26fc75432cfb6f0b', '2e96ab2190487a57', '2f24a5a347895768', '34c9a69071867d99', '4977c5d038f7a43d', '63b5cd9b8d8176e4', 'bc290356f5a668a7', 'efa94bfb14449576'],
     "an internal, cover or personal domain of ours"),
]


def bad_names(text):
    words = [w for w in re.split(r"[^A-Za-z0-9]+", text) if w]
    cands = set()
    for i, w in enumerate(words):
        for n in range(1, 5):                      # 1..4-word n-grams
            if i + n > len(words):
                break
            grp = words[i:i + n]
            for j in ("", "-", "."):               # a-b, a.b and ab spellings
                cands.add(j.join(grp))
    seen = {_digest(c): c for c in cands}
    for digests, why in HASHED_NAMES:
        for dg in digests:
            if dg in seen:
                return seen[dg], why
    return None, ""

# This file quotes what it blocks, so scanning it would always refuse. The exemption is
# named here rather than hidden in a weaker pattern.
EXEMPT = {".githooks/pre-commit"}


def bad_v4(text):
    for m in RX_V4.finditer(text):
        try:
            a = ipaddress.ip_address(m.group(0))
        except ValueError:
            continue
        if not a.is_private or a.is_loopback or a.is_link_local:
            continue                       # public/loopback/APIPA: not our map
        if any(a in n for n in ALLOW_V4_NETS):
            continue
        return m, "a private address outside the documentation ranges this repo uses"
    return None, ""


def bad_v6(text):
    for m in RX_V6.finditer(text):
        raw = m.group(0)
        if raw.count(":") < 2:
            continue
        # ⚠️ DO NOT rstrip(":") — that turns the PREFIX form `2a01:...:2c00::` into
        # `2a01:...:2c00`, which does not parse, so the match is skipped and a prefix written
        # as `::/64` sails through. That is the exact string this whole cleanup was about, and
        # the gate could not see it until a test fed it the real value. Try the match as
        # found, and only then a single trailing colon removed.
        a = None
        try:
            a = ipaddress.ip_network(raw, strict=False).network_address if "/" in raw \
                else ipaddress.ip_address(raw)
        except ValueError:
            try:
                a = ipaddress.ip_address(raw.rstrip(":") or raw)
            except ValueError:
                continue
        if a is None or a.version != 6:
            continue
        if a.is_loopback or a.is_link_local or a.is_multicast or a.is_unspecified:
            continue
        if raw in ALLOW_V6_LITERAL:
            continue
        if any(a in n for n in ALLOW_V6_NETS):
            continue
        if a.is_global:
            return m, ("a GLOBALLY ROUTABLE IPv6 address — unlike RFC1918 this is reachable, "
                       "and it names an ISP, a country and a machine")
        if a.is_private:
            return m, "a ULA outside the documentation prefix this repo uses"
    return None, ""


def bad_mac(text):
    for m in RX_MAC.finditer(text):
        if not ALLOW_MAC.match(m.group(0).replace("\\", "").replace("-", ":")):
            return m, ("a MAC outside RFC 7042's documentation range — real hardware, and the "
                       "tell-tale of a pasted `ip`/`nmcli` capture")
    return None, ""


# ⚠️ A COMMIT MESSAGE IS PUBLISHED CONTENT AND THIS GATE COULD NOT SEE IT.
# Found 2026-09-10, before the first push: the message explaining the removal of a real
# globally-routable /64 QUOTED that /64, and the message adding the box-model axis quoted the
# box model. Both would have published, permanently, the exact strings their own commits
# removed — and the standing decision is not to rewrite published history, so a log entry is
# forever. `pre-commit` inspects staged FILES; the message is a different surface, and needs
# `commit-msg`. A gate whose scope excludes a published surface reads exactly like a clean one.
def scan_text(text):
    for scan in (bad_v4, bad_v6, bad_mac):
        m, why = scan(text)
        if m:
            return m, why
    tok, why = bad_names(text)
    if tok:
        class _M:                      # a token match, not a regex match
            def group(self, _=0): return tok
        return _M(), why
    return None, ""


def check_message(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    # Ignore comment lines git strips, and the scissors section.
    body = "\n".join(l for l in text.split("\n") if not l.startswith("#"))
    m, why = scan_text(body)
    if m:
        print("\n\u2717 COMMIT REFUSED \u2014 the MESSAGE names the network this repo must not "
              "describe:\n", file=sys.stderr)
        print(f"      found: {m.group(0)[:40]!r}\n      why:   {why}\n", file=sys.stderr)
        print("A commit message is published content and cannot be rewritten once pushed.",
              file=sys.stderr)
        print("Describe the value instead of quoting it.\n", file=sys.stderr)
        sys.exit(1)
    sys.exit(0)


if "--message" in sys.argv:
    check_message(sys.argv[sys.argv.index("--message") + 1])


def staged_files():
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM", "-z"],
        capture_output=True, check=True, text=True).stdout
    return [f for f in out.split("\0") if f and f not in EXEMPT]


findings = []
try:
    for path in staged_files():
        raw = subprocess.run(["git", "show", f":{path}"],
                             capture_output=True, check=True).stdout
        if b"\0" in raw[:8000]:
            continue                       # binary: nothing text-shaped to find
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:
            continue
        hit = None
        for scan in (bad_v4, bad_v6, bad_mac):
            m, why = scan(text)
            if m:
                hit = (m, why)
                break
        if not hit:
            tok, why = bad_names(text)
            if tok:
                findings.append((path, tok[:40], why))
                continue
        if hit:
            m, why = hit
            findings.append((f"{path}:{text[:m.start()].count(chr(10)) + 1}",
                             m.group(0)[:40], why))
except Exception as e:                     # FAIL CLOSED — never pass on our own error
    print(f"{VERSION}: FAILED TO COMPLETE ({e.__class__.__name__}: {e})", file=sys.stderr)
    print("Refusing the commit. A guard that cannot run must not look like a clean scan.",
          file=sys.stderr)
    sys.exit(1)

if findings:
    print("\n✗ COMMIT REFUSED — this repository is PUBLIC and the staged content names "
          "the network it was written on:\n", file=sys.stderr)
    for where, snippet, why in findings:
        print(f"  {where}\n      found: {snippet!r}\n      why:   {why}\n", file=sys.stderr)
    print("Use a generic value instead — the fixtures use 10.0.0.0/24, 2001:db8::/32 and",
          file=sys.stderr)
    print("00:00:5E:00:53:xx. If the example is genuinely new, add it to the allowlist at",
          file=sys.stderr)
    print("the top of .githooks/pre-commit, where the exception stays visible.\n", file=sys.stderr)
    sys.exit(1)

sys.exit(0)
